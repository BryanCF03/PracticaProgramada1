@model Clientes.Abstracciones.ModelosParaUI.ClienteDto

@{
    ViewBag.Title = "Editar Cliente";
}

<h2>Editar Cliente</h2>

@using (Html.BeginForm("EditarCliente", "Clientes", FormMethod.Post))
{
    @Html.HiddenFor(m => m.Identificacion)

    <div class="form-group">
        @Html.LabelFor(m => m.Identificacion)
        @Html.TextBoxFor(m => m.Identificacion, new { @class = "form-control", @readonly = "readonly" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Nombre)
        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.PrimerApellido)
        @Html.TextBoxFor(m => m.PrimerApellido, new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.SegundoApellido)
        @Html.TextBoxFor(m => m.SegundoApellido, new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Telefono)
        @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.CorreoElectronico)
        @Html.TextBoxFor(m => m.CorreoElectronico, new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Estado)
        @Html.TextBoxFor(m => m.Estado, new { @class = "form-control" })
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
    @Html.ActionLink("Cancelar", "ListarClientes", null,
        new { @class = "btn btn-secondary" })
}